generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  password        String
  role            Role             @default(STUDENT)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  profileImagePath String? 
  collegeId       String?
  auditLogs       AuditLog[]
  cohortMembers   CohortMember[]
  primaryCollege  College?         @relation("CollegePrimaryAdmin")
  reviewerProfile ReviewerProfile?
  studentProfile  StudentProfile?
  college         College?         @relation("CollegeUsers", fields: [collegeId], references: [id])

  @@index([email])
  @@index([role])
  @@index([collegeId])
}

model College {
  id             String        @id @default(cuid())
  name           String
  domain         String        @unique
  logoUrl        String?
  primaryAdminId String?       @unique
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  cohorts        Cohort[]
  primaryAdmin   User?         @relation("CollegePrimaryAdmin", fields: [primaryAdminId], references: [id])
  inviteTokens   InviteToken[]
  users          User[]        @relation("CollegeUsers")

  @@index([domain])
}

model Cohort {
  id         String           @id @default(cuid())
  collegeId  String
  name       String
  templateId String
  startDate  DateTime
  endDate    DateTime
  status     CohortStatus     @default(DRAFT)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  college    College          @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  template   ProjectTemplate  @relation(fields: [templateId], references: [id])
  members      CohortMember[]
  reviewers    CohortReviewer[]
  plans        InternshipPlan[]
  inviteTokens InviteToken[]

  @@index([collegeId])
  @@index([status])
  @@index([templateId])
}

model CohortMember {
  id                String          @id @default(cuid())
  cohortId          String
  userId            String
  studentId         String?
  externalStudentId String?
  createdAt         DateTime        @default(now())
  cohort            Cohort          @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  student           StudentProfile? @relation(fields: [studentId], references: [id])
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([cohortId, userId])
  @@index([cohortId])
  @@index([userId])
}

model CohortReviewer {
  id         String          @id @default(cuid())
  cohortId   String
  reviewerId String
  createdAt  DateTime        @default(now())
  cohort     Cohort          @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  reviewer   ReviewerProfile @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([cohortId, reviewerId])
  @@index([cohortId])
  @@index([reviewerId])
}

model InviteToken {
  id          String     @id @default(cuid())
  collegeId   String?
  cohortId    String?
  email       String
  token       String     @unique
  type        InviteType @default(COLLEGE_ADMIN)
  inviteeName String?
  expiresAt   DateTime
  used        Boolean    @default(false)
  usedAt      DateTime?
  createdAt   DateTime   @default(now())
  college     College?   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  cohort      Cohort?    @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([cohortId])
  @@index([email])
  @@index([token])
}

model StudentProfile {
  id              String           @id @default(uuid())
  userId          String           @unique
  firstName       String
  lastName        String
  phone           String?
  dateOfBirth     DateTime?
  address         String?
  city            String?
  country         String?
  bio             String?
  linkedIn        String?
  github          String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  graduationYear  Int?
  university      String?
  cohortMembers   CohortMember[]
  internshipPlans InternshipPlan[]
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ReviewerProfile {
  id                String            @id @default(uuid())
  userId            String            @unique
  firstName         String
  lastName          String
  phone             String?
  bio               String?
  expertise         String[]
  linkedIn          String?
  github            String?
  isAvailable       Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  cohortAssignments CohortReviewer[]
  planProjects      PlanProject[]
  projectTemplates  ProjectTemplate[]
  reviews           Review[]
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isAvailable])
}

model ProjectTemplate {
  id               String           @id @default(uuid())
  title            String
  description      String
  shortDescription String?
  category         String
  difficulty       String
  duration         Int
  skills           String[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  reviewerId       String?
  figmaLink        String?
  imageAlt         String?
  imagePublicId    String?
  imageUrl         String?
  publishedAt      DateTime?
  status           TemplateStatus   @default(DRAFT)
  techStack        String[]
  version          Int              @default(1)
  cohorts          Cohort[]
  planProjects     PlanProject[]
  reviewer         ReviewerProfile? @relation(fields: [reviewerId], references: [id])
  templateTasks    TemplateTask[]

  @@index([status])
  @@index([reviewerId])
  @@index([category])
  @@index([difficulty])
}

model TemplateTask {
  id              String          @id @default(uuid())
  templateId      String
  title           String
  description     String
  order           Int
  durationDays    Int
  dependsOnTaskId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  dependsOnTask   TemplateTask?   @relation("TaskDependency", fields: [dependsOnTaskId], references: [id])
  dependentTasks  TemplateTask[]  @relation("TaskDependency")
  template        ProjectTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([order])
  @@index([dependsOnTaskId])
}

model InternshipPlan {
  id                   String         @id @default(uuid())
  studentId            String
  durationType         DurationType
  totalWeeks           Int
  combination          Int[]
  sequentialCompletion Boolean        @default(true)
  completedWeeks       Int            @default(0)
  isCompleted          Boolean        @default(false)
  startedAt            DateTime       @default(now())
  completedAt          DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  overdueTaskCount     Int            @default(0)
  status               PlanStatus     @default(ACTIVE)
  cohortId             String?
  certificate          Certificate?
  cohort               Cohort?        @relation(fields: [cohortId], references: [id])
  student              StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  planProjects         PlanProject[]

  @@index([studentId])
  @@index([isCompleted])
  @@index([status])
  @@index([cohortId])
}

model PlanProject {
  id          String            @id @default(uuid())
  planId      String
  templateId  String
  order       Int
  status      PlanProjectStatus @default(LOCKED)
  reviewerId  String?
  isCompleted Boolean           @default(false)
  startedAt   DateTime?
  completedAt DateTime?
  approvedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  milestones  Milestone[]
  plan        InternshipPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)
  reviewer    ReviewerProfile?  @relation(fields: [reviewerId], references: [id])
  template    ProjectTemplate   @relation(fields: [templateId], references: [id])

  @@unique([planId, templateId])
  @@index([planId])
  @@index([templateId])
  @@index([status])
  @@index([reviewerId])
}

model Milestone {
  id          String      @id @default(uuid())
  projectId   String
  title       String
  description String
  order       Int
  isCompleted Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  project     PlanProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([projectId])
}

model Task {
  id           String      @id @default(uuid())
  milestoneId  String
  title        String
  description  String
  order        Int
  status       TaskStatus  @default(DRAFT)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  durationDays Int
  dueAt        DateTime?
  isOverdue    Boolean     @default(false)
  startAt      DateTime?
  isLocked     Boolean     @default(true)
  submission   Submission?
  milestone    Milestone   @relation(fields: [milestoneId], references: [id], onDelete: Cascade)

  @@index([milestoneId])
  @@index([status])
  @@index([dueAt])
  @@index([isOverdue])
  @@index([isLocked])
}

model Submission {
  id          String   @id @default(uuid())
  taskId      String   @unique
  prLink      String?
  commitHash  String?
  description String
  screenshots String[]
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  review      Review?
  task        Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Review {
  id            String          @id @default(uuid())
  reviewerId    String
  status        ReviewStatus    @default(PENDING)
  feedback      String?
  codeQuality   Int?
  documentation Int?
  reviewedAt    DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  submissionId  String          @unique
  reviewer      ReviewerProfile @relation(fields: [reviewerId], references: [id])
  submission    Submission      @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId])
  @@index([reviewerId])
  @@index([status])
}

model Certificate {
  id              String            @id @default(uuid())
  planId          String            @unique
  studentId       String
  certificateUrl  String
  certificateHash String
  issuedAt        DateTime          @default(now())
  status          CertificateStatus @default(ISSUED)
  revokedAt       DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  plan            InternshipPlan    @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([studentId])
  @@index([certificateHash])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([type])
}

model AuditLog {
  id         String      @id @default(uuid())
  userId     String?
  action     AuditAction
  resource   String
  resourceId String?
  changes    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  user       User?       @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt])
}

enum Role {
  STUDENT
  REVIEWER
  SUPER_ADMIN
  COLLEGE_ADMIN
}

enum InviteType {
  COLLEGE_ADMIN
  REVIEWER
  GLOBAL_REVIEWER
  STUDENT
}

enum CohortStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum DurationType {
  FOUR_WEEKS
  EIGHT_WEEKS
  TWELVE_WEEKS
  CUSTOM
}

enum PlanStatus {
  ACTIVE
  AT_RISK
  NEEDS_ATTENTION
  COMPLETED
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PlanProjectStatus {
  LOCKED
  AVAILABLE
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum TaskStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  LOCKED
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum CertificateStatus {
  ISSUED
  REVOKED
}

enum NotificationType {
  SUBMISSION_RECEIVED
  REVIEW_COMPLETED
  CERTIFICATE_ISSUED
  PLAN_ASSIGNED
  MILESTONE_COMPLETED
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  APPROVE
  REJECT
  ASSIGN
  UNASSIGN
  PUBLISH
  UNPUBLISH
  UNLOCK
}
